{
  "name": "stay-awake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first Chrome and Edge screen wake extension",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace @stay-awake/extension",
    "dev:website": "npm run dev --workspace @stay-awake/website",
    "build": "npm run build:extension && npm run build:website",
    "build:extension": "npm run build --workspace @stay-awake/extension",
    "build:website": "npm run build --workspace @stay-awake/website",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package:extension": "node scripts/package-extension.mjs",
    "release:local": "npm run build:extension && npm run package:extension",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.6",
    "vitest": "^3.1.1",
    "@playwright/test": "^1.52.0"
  }
}
