{
  "name": "stay-awake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "description": "Local-first Chrome and Edge screen wake extension",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev --workspace @stay-awake/extension",
    "dev:website": "npm run dev --workspace @stay-awake/website",
    "build": "npm run build:extension && npm run build:website",
    "build:extension": "npm run build --workspace @stay-awake/extension",
    "build:website": "npm run build --workspace @stay-awake/website",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "release:local": "npm run build:extension && npm run package:extension",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.21.1 <12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.6",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
